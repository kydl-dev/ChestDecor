<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ChestDecor mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "ChestDecor-Mod\ChestDecor.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>ChestDecor</AssemblyName>
    <RootNamespace>ChestDecor</RootNamespace>
    <PackageId>ChestDecor</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\chestdecor exists -->
    <BundleName>chestdecor</BundleName>
  </PropertyGroup>

  <ItemGroup>
    <!-- the mod's menu views live in the Unity project (previewed there) and are compiled into the mod from there -->
    <Compile Include="..\ChestDecor-Unity\Assets\ChestDecor_UI\Runtime\*.cs" Link="UiViews\%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
