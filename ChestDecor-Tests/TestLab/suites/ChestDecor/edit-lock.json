{
  "name": "edit-lock",
  "description": "One editor at a time: the lock can be taken and released",
  "timeout": 60,
  "steps": [
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 3,
      "owner": "me",
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "chestdecor.lock",
      "args": {
        "chest": "chest"
      },
      "contains": "held",
      "label": "taken"
    },
    {
      "do": "hook",
      "name": "chestdecor.unlock",
      "args": {
        "chest": "chest"
      },
      "expect": true,
      "label": "released"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ChestDecor"
    }
  ]
}