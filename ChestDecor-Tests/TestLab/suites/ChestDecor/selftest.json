{
  "name": "selftest",
  "description": "ChestDecor's own in-game checks pass",
  "timeout": 60,
  "steps": [
    {
      "do": "wait",
      "seconds": 6
    },
    {
      "do": "hook",
      "name": "chestdecor.selftest",
      "notContains": "FAIL",
      "contains": "PASS"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ChestDecor"
    }
  ]
}