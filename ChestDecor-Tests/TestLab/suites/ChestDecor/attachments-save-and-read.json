{
  "name": "attachments-save-and-read",
  "description": "Attached items are stored on the chest and survive a serialise / parse round trip",
  "timeout": 60,
  "steps": [
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 3,
      "owner": "me",
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "chestdecor.attachCount",
      "args": {
        "chest": "chest"
      },
      "expect": 0
    },
    {
      "do": "hook",
      "name": "chestdecor.attach",
      "args": {
        "chest": "chest",
        "prefab": "TrophyDeer"
      },
      "expect": 1
    },
    {
      "do": "hook",
      "name": "chestdecor.attach",
      "args": {
        "chest": "chest",
        "prefab": "Apple"
      },
      "expect": 2
    },
    {
      "do": "hook",
      "name": "chestdecor.attachPrefab",
      "args": {
        "chest": "chest",
        "index": 0
      },
      "expect": "TrophyDeer"
    },
    {
      "do": "hook",
      "name": "chestdecor.attachPrefab",
      "args": {
        "chest": "chest",
        "index": 1
      },
      "expect": "Apple"
    },
    {
      "do": "hook",
      "name": "chestdecor.attachRoundTrip",
      "args": {
        "chest": "chest"
      },
      "expect": true
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ChestDecor"
    }
  ]
}