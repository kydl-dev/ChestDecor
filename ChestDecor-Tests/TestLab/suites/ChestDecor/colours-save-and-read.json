{
  "name": "colours-save-and-read",
  "description": "Saving colours stores them in the chest's ZDO and they read back unchanged",
  "timeout": 60,
  "steps": [
    {
      "do": "spawn",
      "prefab": "piece_chest_wood",
      "dz": 3,
      "owner": "me",
      "as": "chest"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "hook",
      "name": "chestdecor.savedCount",
      "args": {
        "chest": "chest"
      },
      "expect": 0,
      "label": "nothing saved yet"
    },
    {
      "do": "hook",
      "name": "chestdecor.paint",
      "args": {
        "chest": "chest",
        "hex": "FF0000"
      },
      "min": 1,
      "label": "parts painted"
    },
    {
      "do": "hook",
      "name": "chestdecor.savedHex",
      "args": {
        "chest": "chest"
      },
      "expect": "FF0000"
    },
    {
      "do": "hook",
      "name": "chestdecor.paint",
      "args": {
        "chest": "chest",
        "hex": "3366CC",
        "mode": "Tint"
      },
      "min": 1
    },
    {
      "do": "hook",
      "name": "chestdecor.savedHex",
      "args": {
        "chest": "chest"
      },
      "expect": "3366CC",
      "label": "a second save replaces the first"
    },
    {
      "do": "hook",
      "name": "chestdecor.resetColours",
      "args": {
        "chest": "chest"
      },
      "expect": 0,
      "label": "reset removes them"
    }
  ],
  "asserts": [
    {
      "check": "noErrors",
      "source": "ChestDecor"
    }
  ]
}